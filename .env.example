# ──────────────────────────────────────────────
# Apple In-App Purchase (StoreKit 2 / App Store Server API)
# ──────────────────────────────────────────────
APPLE_BUNDLE_ID=com.classystudy.app
APPLE_APP_ID=1234567890
APPLE_IAP_ISSUER_ID=00000000-0000-0000-0000-000000000000
APPLE_IAP_KEY_ID=ABCDEFGHIJ
# AuthKey_*.p8 파일 전체를 base64로 인코딩한 한 줄 값
APPLE_IAP_PRIVATE_KEY_BASE64=
APPLE_IAP_ENVIRONMENT=SANDBOX
APPLE_IAP_ENABLE_ONLINE_CHECKS=true
# Google Play Billing / RTDN
GOOGLE_PLAY_PACKAGE_NAME=com.classystudy.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
# SMS 인증번호 유효 시간(초)
PHONE_VERIFICATION_TTL_SECONDS=300
# 인증 완료 후 비밀번호 재설정 토큰 유효 시간(초)
PASSWORD_RESET_TOKEN_TTL_SECONDS=600
